---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const props = Astro.props;

const classList = [
    "flex items-center gap-2 py-1 px-3 rounded-full text-xs font-medium border",
    props.href != null
        ? "transition-all duration-200 ease-in-out hover:scale-105"
        : "",
    props.class,
];
---

<a href={props.href} class:list={classList}>
    <slot />
</a>

<style>
    a {
        background: var(--color-foreground-7);
        border-color: var(--color-badge-border);
    }
    a:hover {
        border-color: var(--color-badge-hover-border);
    }
</style>
