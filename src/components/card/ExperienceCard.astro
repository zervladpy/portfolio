---
import Badge from "@components/widgets/Badge.astro";
import TimeStamp from "@components/widgets/TimeStamp.astro";

interface Props {
    experience: {
        position: string;
        company: string;
        badge?: string;
        description: string;
        dates: {
            start: string;
            end?: string;
        };
    };
}

const { position, company, badge, description, dates } = Astro.props.experience;
---

<article class="flex flex-row gap-5 rounded-2xl p-5 border transition-all duration-300 hover:-translate-y-0.5">
    <TimeStamp startDate={dates.start} endDate={dates.end} />
    <div class="flex flex-col flex-1">
        <div class="flex flex-row justify-between pb-3">
            <header>
                <h3 class="text-base font-semibold">{position}</h3>
                <h4 class="text-sm" style="color: var(--color-foreground-muted)">{company}</h4>
            </header>
            {
                badge && (
                    <div>
                        <Badge>{badge}</Badge>
                    </div>
                )
            }
        </div>
        <p class="text-sm leading-relaxed">{description}</p>
    </div>
</article>
<style>
    article {
        background-color: var(--color-surface);
        border-color: var(--color-border);
    }
    article:hover {
        background-color: var(--color-surface-hover);
        border-color: var(--color-card-border-hover);
    }
    p {
        color: var(--color-foreground-muted);
    }
</style>
