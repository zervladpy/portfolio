---
import Badge from "@components/widgets/Badge.astro";
import MailIcon from "@assets/icons/Mail.astro";
import GitHubIcon from "@assets/icons/GitHub.astro";
import LinkedInIcon from "@assets/icons/LinkedIn.astro";

interface Props {
    content: {
        name: string;
        position: string;
        description: string;
        picture: string;
        mail: string;
    };
    social: {
        github: string;
        linkedin: string;
    };
}

const props = Astro.props;

const { name, position, description, mail, picture } = props.content;
const social = props.social;
---

<div class="flex flex-col gap-5 pt-6 pb-2">
    <div class="inline-block" style="animation: fade-up 0.6s ease both 0.05s">
        <img
            class="relative size-28 rounded-full object-cover"
            style="box-shadow: 0 0 0 1.5px rgba(255,255,255,0.35)"
            src={picture}
            alt="profile image"
        />
    </div>

    <div class="flex flex-col gap-1" style="animation: fade-up 0.6s ease both 0.15s">
        <h1 class="text-4xl font-bold tracking-tight">{name}</h1>
        <p class="text-sm font-medium" style="color: #888888; font-style: italic">{position}</p>
    </div>

    <p
        class="text-sm max-w-md leading-relaxed"
        style="color: var(--color-foreground-muted); animation: fade-up 0.6s ease both 0.25s"
    >{description}</p>

    <div class="flex gap-4" style="animation: fade-up 0.6s ease both 0.35s">
        <Badge href={social.github}><GitHubIcon class="size-4" /> GitHub</Badge>
        <Badge href={social.linkedin}><LinkedInIcon class="size-4" /> LinkedIn</Badge>
        <Badge href=`mailto:${mail}`>
            <MailIcon class="size-4" />
            <span>Mail</span>
        </Badge>
    </div>
</div>
