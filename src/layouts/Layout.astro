---
import type { locale } from "@lib/locale";

interface Props {
	title: string;
	description?: string;
	locale?: locale;
}

const { title, description, locale } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div class="gradient"></div>
		<div class="content px-5 sm:px-8"><slot /></div>
	</body>
</html>

<style is:global>
	:root {
		--color-primary: #ffffff;
		--color-accent: #f8f8f8;
		--color-background: #0a0a0a;
		--color-surface: transparent;
		--color-surface-hover: rgba(248, 248, 248, 0.03);
		--color-border: rgba(255, 255, 255, 0.12);
		--color-foreground: #f8f8f8;
		--color-foreground-muted: #888888;
		--color-foreground-7: rgba(248, 248, 248, 0.04);
		--color-foreground-80: rgba(248, 248, 248, 0.8);
	}

	@font-face {
		font-family: "Poppins";
		src: url("/fonts/poppins/Poppins.ttf") format("truetype");
		font-weight: 400;
		font-display: swap;
		font-style: normal;
	}

	@font-face {
		font-family: "Poppins";
		src: url("/fonts/poppins/Poppins.ttf") format("truetype");
		font-weight: 500 600;
		font-display: swap;
		font-style: normal;
	}

	@font-face {
		font-family: "Poppins";
		src: url("/fonts/poppins/Poppins.ttf") format("truetype");
		font-weight: 700;
		font-display: swap;
		font-style: normal;
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	body {
		background-color: var(--color-background);
		margin: 0;
		position: relative;
	}

	.gradient {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background: radial-gradient(
			80% 50% at 50% -5%,
			var(--color-primary),
			var(--color-background) 70%
		);
		z-index: -1;
	}

	.content {
		position: relative;
		z-index: 1;
		margin-inline: auto;
		width: min(860px, 100%);
		color: var(--color-foreground);
		font-family: Poppins, sans-serif;
	}
</style>
