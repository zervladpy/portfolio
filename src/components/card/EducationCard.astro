---
import Badge from "@components/widgets/Badge.astro";
import TimeStamp from "@components/widgets/TimeStamp.astro";

interface Props {
    education: {
        school: string;
        field: string;
        description: string;
        dates: {
            start: string;
            end?: string;
        };
        grade?: number;
    };
}

const props = Astro.props;
const { school, field, grade, description, dates } = props.education;
---

<article class="flex flex-row gap-5 rounded-2xl p-5 border transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_32px_-8px_rgba(91,33,182,0.3)]">
    <TimeStamp startDate={dates.start} endDate={dates.end} />
    <div class="flex flex-col flex-1">
        <div class="flex flex-row justify-between pb-3">
            <header>
                <h3 class="text-base font-semibold">{field}</h3>
                <h4 class="text-sm" style="color: var(--color-foreground-muted)">{school}</h4>
            </header>
            {
                grade && (
                    <div>
                        <Badge>{grade.toPrecision(2)}</Badge>
                    </div>
                )
            }
        </div>
        <p class="text-sm leading-relaxed">{description}</p>
    </div>
</article>

<style>
    article {
        background-color: var(--color-surface);
        border-color: var(--color-border);
    }

    article:hover {
        background-color: var(--color-surface-hover);
        border-color: var(--color-primary);
    }

    p {
        color: var(--color-foreground-muted);
    }
</style>
