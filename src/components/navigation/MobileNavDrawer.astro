---
import LocaleDropdownMenu from "@components/dropdown/variants/LocaleDropdownMenu.astro";
import ThemeToggle from "@components/ThemeToggle.astro";

interface Props {
    links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

<div id="mobile-drawer-overlay" data-state="closed"></div>

<div id="mobile-drawer" data-state="closed" role="dialog" aria-modal="true" aria-label="Navigation menu">
    <div class="drawer-head">
        <span class="drawer-title">Menu</span>
        <button id="mobile-drawer-close" type="button" aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <div class="drawer-links" role="navigation" aria-label="Sections">
        {links.map((link) => (
            <a href={link.href} class="drawer-link">{link.label}</a>
        ))}
    </div>

    <div class="drawer-footer">
        <div class="drawer-footer-row">
            <span class="drawer-footer-label">Theme</span>
            <ThemeToggle side="top" />
        </div>
        <div class="drawer-footer-row">
            <span class="drawer-footer-label">Language</span>
            <LocaleDropdownMenu side="top" />
        </div>
    </div>
</div>

<script src="/src/scripts/mobileDrawer.ts"></script>

<style>
    #mobile-drawer-overlay {
        position: fixed;
        inset: 0;
        z-index: 60;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        pointer-events: none;
        transition: opacity 250ms ease;
    }

    #mobile-drawer-overlay[data-state="open"] {
        opacity: 1;
        pointer-events: auto;
    }

    #mobile-drawer {
        position: fixed;
        top: 0;
        right: 0;
        z-index: 70;
        display: flex;
        flex-direction: column;
        width: min(300px, 85vw);
        height: 100dvh;
        background: var(--color-header-bg);
        border-left: 1px solid var(--color-header-border);
        backdrop-filter: blur(16px);
        transform: translateX(100%);
        transition: transform 300ms ease;
        padding-top: max(1.25rem, env(safe-area-inset-top));
        padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
    }

    #mobile-drawer[data-state="open"] {
        transform: translateX(0);
    }

    .drawer-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.25rem 1rem;
    }

    .drawer-title {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-accent);
    }

    #mobile-drawer-close {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-foreground-muted);
        border-radius: 6px;
        transition: color 200ms ease;
    }

    #mobile-drawer-close:hover {
        color: var(--color-foreground);
    }

    .drawer-links {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0 0.75rem;
        overflow-y: auto;
    }

    .drawer-link {
        padding: 0.7rem 0.75rem;
        border-radius: 0.6rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--color-foreground-muted);
        transition: color 200ms ease, background 200ms ease;
    }

    .drawer-link:hover {
        color: var(--color-foreground);
        background: var(--color-surface-hover);
    }

    .drawer-footer {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 1rem 1.25rem 0;
        border-top: 1px solid var(--color-divider);
    }

    .drawer-footer-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .drawer-footer-label {
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-foreground-muted);
    }

    @media (min-width: 768px) {
        #mobile-drawer,
        #mobile-drawer-overlay {
            display: none !important;
        }
    }
</style>
