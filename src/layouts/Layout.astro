---
import type { locale } from "@lib/locale";

interface Props {
	title: string;
	description?: string;
	locale?: locale;
}

const { title, description, locale } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0f0f0f" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div class="gradient"></div>
		<div class="content px-5 sm:px-8"><slot /></div>
	</body>
</html>

<style is:global>
	:root {
		--color-primary: #5b21b6;
		--color-secondary: #3b0764;
		--color-accent: #a78bfa;
		--color-background: #0f0f0f;
		--color-surface: #1c1c1e;
		--color-surface-hover: #242428;
		--color-border: #2a2a2e;
		--color-foreground: #f4f4f5;
		--color-foreground-muted: #a1a1aa;
		--color-foreground-7: #f4f4f514;
		--color-foreground-80: #f4f4f5cf;
	}

	@font-face {
		font-family: "Poppins";
		src: url("/fonts/poppins/Poppins.ttf") format("truetype");
		font-weight: 400;
		font-display: swap;
		font-style: normal;
	}

	@font-face {
		font-family: "Poppins";
		src: url("/fonts/poppins/Poppins.ttf") format("truetype");
		font-weight: 500 600;
		font-display: swap;
		font-style: normal;
	}

	@font-face {
		font-family: "Poppins";
		src: url("/fonts/poppins/Poppins.ttf") format("truetype");
		font-weight: 700;
		font-display: swap;
		font-style: normal;
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	body {
		background-color: var(--color-background);
		margin: 0;
		position: relative;
	}

	.gradient {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background: radial-gradient(
			80% 50% at 50% -5%,
			var(--color-primary),
			var(--color-background) 70%
		);
		z-index: -1;
	}

	.content {
		position: relative;
		z-index: 1;
		margin-inline: auto;
		width: min(860px, 100%);
		color: var(--color-foreground);
		font-family: Poppins, sans-serif;
	}
</style>
