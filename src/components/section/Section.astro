---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
    title?: string | null;
}
const props = Astro.props;

const { id, title } = props;

const classList = ["py-12 flex flex-col gap-8", props.class];
---

<section id={id} class:list={classList}>
    {title && (
        <div class="flex flex-col gap-2" style="animation: fade-in 0.4s ease both">
            <h2 class="text-sm font-semibold" style="color: var(--color-accent)">{title}</h2>
            <div class="h-px w-full" style="background: var(--color-divider)"></div>
        </div>
    )}
    <slot />
</section>
