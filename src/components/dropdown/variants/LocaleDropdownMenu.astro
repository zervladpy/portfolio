---
import type { locale } from "@lib/locale";
import { locales } from "@lib/locale";

import Dropdown from "@components/dropdown/Dropdown.astro";
import DropdownLabel from "@components/dropdown/DropdownLabel.astro";
import DropdownMenu from "@components/dropdown/DropdownMenu.astro";
import DropdownMenuItem from "@components/dropdown/DropdownMenuItem.astro";

const currentLocale = Astro.currentLocale ?? "en";

const LOCALE_LABELS: Record<string, string> = {
    en: "EN",
    es: "ES",
    ru: "RU",
    it: "IT",
    pt: "PT",
};
---

<Dropdown class="">
    <DropdownLabel>
        <span class="locale-code">{LOCALE_LABELS[currentLocale] ?? "EN"}</span>
    </DropdownLabel>
    <DropdownMenu>
        {
            locales.map((locale) => {
                if (currentLocale === locale.code) return;
                const href = locale.code !== "en" ? `/${locale.code}` : "/";
                return (
                    <DropdownMenuItem href={href}>
                        <span class="locale-code">{LOCALE_LABELS[locale.code]}</span>
                    </DropdownMenuItem>
                );
            })
        }
    </DropdownMenu>
</Dropdown>

<style>
    .locale-code {
        font-size: 0.75rem;
        font-weight: 600;
        font-family: Poppins, sans-serif;
        letter-spacing: 0.05em;
        color: var(--color-foreground-muted);
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid var(--color-badge-border);
        transition: color 150ms ease, border-color 150ms ease;
        display: inline-block;
        line-height: 1.4;
    }
    .locale-code:hover {
        color: var(--color-foreground);
        border-color: var(--color-badge-hover-border);
    }
</style>
