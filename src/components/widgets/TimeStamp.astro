---
import { i18n } from "@lib/i18n";

interface Props {
    startDate: string;
    endDate?: string;
}

const { startDate, endDate } = Astro.props;

const currentLocale = Astro.currentLocale;

const displayEndDate = endDate || i18n[currentLocale ?? "en"].timeline.actual;
---

<div class="flex flex-col items-center gap-1 pt-1 min-w-[52px]">
    <time class="text-xs font-medium" style="color: var(--color-foreground-muted)">{displayEndDate}</time>
    <span class="flex-grow rounded-full w-0.5 my-1 min-h-[20px]"></span>
    <time class="text-xs font-medium" style="color: var(--color-foreground-muted)">{startDate}</time>
</div>

<style>
    span {
        background: var(--color-timeline-line);
    }
</style>
